# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection strings (Project Settings -> Database)
# DATABASE_URL: the pooled "Transaction" connection string (used at runtime)
# DIRECT_URL: the direct (non-pooled) connection string (used for migrations)
DATABASE_URL=
DIRECT_URL=

# Free USDA FoodData Central API key (broadens food search beyond the local
# database). Get one instantly, no payment, at https://fdc.nal.usda.gov/api-key-signup
# Falls back to the public DEMO_KEY (rate-limited: 30 req/hour, 50/day) if unset.
USDA_FDC_API_KEY=
